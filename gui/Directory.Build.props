<Project>
  <!-- Keep bin/obj off the NAS: build outputs live in the local build tree. -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(LOCALAPPDATA)\sdi_converter2\gui-obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(LOCALAPPDATA)\sdi_converter2\gui-bin\</BaseOutputPath>
  </PropertyGroup>
</Project>
